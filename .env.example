# x402git environment: TESTNET AND LOCAL DEVELOPMENT ONLY.
#
# Copy this file to .env (gitignored) and fill it in. Every value below is a
# placeholder or a Base Sepolia / local-dev default. Never put a mainnet key, a
# production secret or a funded wallet in a file you might share.
#
# lib/env.ts is the schema. Almost everything is optional: an unset value turns
# its feature off rather than crashing the app. Local setup: docs/SELF-HOST.md.

# --- App ----------------------------------------------------------------------

# Public base URL of this deployment; used in links, 402 resource URLs and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------------
# `supabase start` prints all of these for a local stack. Hosted: project settings > API.

# API URL of your Supabase project (local default shown).
SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key.
SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key. Server-side only; never expose it to a browser.
SUPABASE_SECRET_KEY=
# Database password. Read by the `supabase` CLI only, never by app code.
SUPABASE_DB_PASSWORD=

# --- GitHub App ---------------------------------------------------------------
# `npm run app:github` creates your own App and writes the six GITHUB_APP_* / GITHUB_OAUTH_*
# values below into .env. Or create one by hand at github.com/settings/apps.

# Numeric App ID.
GITHUB_APP_ID=
# The App's URL slug, for the "install on a repo" link. Unset falls back to the production App.
GITHUB_APP_SLUG=
# App private key (PEM) on one line in double quotes, with newlines written as \n.
GITHUB_APP_PRIVATE_KEY=
# Secret GitHub signs webhook deliveries with.
GITHUB_APP_WEBHOOK_SECRET=
# OAuth client ID and secret of the same App, for creator sign-in.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Comma-separated GitHub orgs that host Rail B repos (orgs where your App is installed). Optional.
GITHUB_HOSTED_ORGS=

# --- x402 and chain -----------------------------------------------------------

# Payment network: base-sepolia (testnet) or a CAIP-2 id. Keep base-sepolia for development.
X402_NETWORK=base-sepolia
# Facilitator that verifies and settles payments. The public x402.org one serves Base Sepolia.
X402_FACILITATOR_URL=https://x402.org/facilitator
# USDC contract override. Leave commented to use Circle's USDC for X402_NETWORK (Base Sepolia shown).
# X402_ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Read-only JSON-RPC for the payout sweep and reconcile. Defaults to the public Base endpoint.
EVM_RPC_URL=https://sepolia.base.org
# Coinbase CDP API key pair, only for the CDP facilitator (mainnet). Leave empty on Base Sepolia.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Payouts ------------------------------------------------------------------

# Testnet address that receives buyer payments (the 402 payTo). Paid routes fail until it is set.
PLATFORM_RECEIVING_ADDRESS=
# Private key of the testnet sweep wallet that pays creators. Use a throwaway
# (`node scripts/new-wallet.mjs <name>`) funded with Base Sepolia ETH for gas. Optional.
SWEEP_WALLET_PRIVATE_KEY=
# Platform fee in basis points (1000 = 10%). Must be an integer.
PLATFORM_FEE_BPS=1000
# Days a sale is held before it can be paid out. Must be an integer.
HOLDBACK_DAYS=7

# --- Sessions and secrets -----------------------------------------------------

# Signs and encrypts the creator session cookie. Generate with `openssl rand -hex 32`.
SESSION_SECRET=
# Bearer token cron routes require when set. Generate with `openssl rand -hex 32`. Unset leaves them open (local only).
CRON_SECRET=
# HMAC key for signed webhooks sent to creators' abuse contact URLs. Unset sends nothing.
ABUSE_WEBHOOK_SECRET=
# Comma-separated GitHub logins that are root admins of /admin. Unset admits nobody.
ADMIN_GITHUB_LOGINS=

# --- Product settings ---------------------------------------------------------

# Seconds a resent payment signature still counts as a crash-retry of the same purchase. Must be an integer.
REPLAY_GRANT_WINDOW_SEC=600
# Comma-separated invite codes required to register for Rail B (hosted repos). Optional.
RAIL_B_INVITE_CODES=
# Terms and analyzer versions. Leave commented to use the defaults in lib/env.ts.
# TERMS_VERSION=
# ANALYZER_VERSION=

# --- Search indexing ----------------------------------------------------------

# IndexNow key (8-128 hex chars) to ping Bing when a listing changes. Generate with `openssl rand -hex 16`. Optional.
INDEXNOW_KEY=

# --- Notifications ------------------------------------------------------------

# Telegram admin notifications: bot token from @BotFather and the channel id (-100...).
# Optional; set on production only, never on previews.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Scanners -----------------------------------------------------------------

# Socket.dev dependency-behaviour scan: org slug and API token from socket.dev. Optional.
SOCKET_ORG_SLUG=
SOCKET_TOKEN_VALUE=
# Timeout in ms for each OSV request. A batch-query timeout leaves the scan incomplete; a detail
# lookup that times out or is cut off by the deadline becomes a non-blocking UNKNOWN advisory. Must be an integer.
OSV_TIMEOUT_MS=20000

# --- Testing and end-to-end harnesses ------------------------------------------
# The e2e scripts settle real testnet USDC and are never run in CI.

# Throwaway Base Sepolia buyer wallet. Fund it with test USDC from https://faucet.circle.com.
TEST_BUYER_PRIVATE_KEY=
TEST_BUYER_ADDRESS=
# Overrides for scripts/e2e-*.mjs. Leave commented to use their defaults.
# BASE_URL=http://localhost:3000
# E2E_LISTING=owner/slug
# E2E_WORKDIR=
# E2E_RAIL_A_INSTALLATION_ID=
# E2E_RAIL_A_REPO_ID=
# E2E_RAIL_A_CLONE=
# X402_CHAIN_ID=84532

# --- Maintainer-only tooling ----------------------------------------------------
# Used by the x402git operators' scripts. Contributors and self-hosters can ignore this block.

# 1Password account and vault for `npm run env:status|pull|push` (scripts/env-sync.mjs). Maintainer-only.
# X402_OP_ACCOUNT=
# X402_OP_VAULT=
# GitHub token to lift the API rate limit for `npm run x402:check`. Optional.
# GITHUB_TOKEN=
# Base MAINNET wallet for `npm run bazaar:check -- --pay`. Spends real USDC. Maintainer-only; leave unset.
# BAZAAR_SEED_PRIVATE_KEY=
